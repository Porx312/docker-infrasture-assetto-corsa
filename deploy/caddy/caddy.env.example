# Copy to deploy/caddy/caddy.env and set your Cloudflare DNS A records to the VPS public IP.
#   cp deploy/caddy/caddy.env.example deploy/caddy/caddy.env

# Staging hostnames (Hostinger A → VPS public IP)
STAGING_API_HOST=dev-api.projectd.space
STAGING_ADMIN_HOST=dev-admin.projectd.space
AC_DATA_UPSTREAM=127.0.0.1:3000
ACME_EMAIL=admin@projectd.space
