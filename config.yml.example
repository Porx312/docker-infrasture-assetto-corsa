################################################################################
# Assetto Server Manager Configuration (template — copy to config.yml locally)
# Do NOT commit config.yml with real credentials.
################################################################################

steam:
  username: YOUR_STEAM_USERNAME
  password: ${STEAM_PASSWORD}
  install_path: assetto
  executable_path: acServer
  force_update: false

http:
  hostname: 127.0.0.1:8772
  session_key: GENERATE_A_RANDOM_SESSION_KEY
  session_store_type: cookie

store:
  type: boltdb
  path: server_manager.db

server:
  audit_logging: true
  performance_mode: false
  use_car_name_cache: true

monitoring:
  enabled: false
