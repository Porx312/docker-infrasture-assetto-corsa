# Nested hub repo (own git remote; do not commit into assetto-infra)
ProjectD-Backend-Servers/

# Environment files (contain secrets)
.env
.env.local
.env.production
.env.*.local

# Logs
*.log
ac-data.log
ac-data.pid

# Node modules
node_modules/
packages/*/node_modules/
telemetry-data/__pycache__/
telemetry-data/*.pyc

# AC Server content (too large, managed separately)
assetto-install/

# Results and logs from servers
**/results/
**/logs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build artifacts
packages/*/dist/
telemetry-data/.pytest_cache/

# Docker volumes
redis-data/

# Runtime data
**/server_pids.json
telemetry-data/redis_applied_config_versions.json
# ProjectD HUD / launcher release ZIPs + manifests (admin panel uploads; runtime only)
packages/ac-data-edge/projectd-hud/manifest.json
packages/ac-data-edge/projectd-hud/releases/*
!packages/ac-data-edge/projectd-hud/releases/.gitkeep
packages/ac-data-backend/projectd-hud/manifest.json
packages/ac-data-backend/projectd-hud/releases/*
!packages/ac-data-backend/projectd-hud/releases/.gitkeep
ProjectD-HUD/releases/
ProjectD-HUD/*.zip

# Server Manager local config (may contain Steam credentials)
config.yml

# AC server fleet — per-instance config (Convex/ac-data, CM scripts)
server/cfg/
server/**/cfg/
server/entry_list.ini
server/server_cfg.ini
server/presets/
server/**/blacklist.txt

# Content Manager: descriptions, loading images, wrapper params (generated)
server/shared/server-branding.json
server/shared/cm-proxy-pids/
server/shared/cm-proxy-logs/