# Copy to .env.local (dev) or .env.production (prod). Do not commit secrets.
#   cp .env.example .env.local

# --- Core ---
AC_INSTANCE_ID=default
SERVERS_PATH=/home/jose/assetto-infra/server
CONTENT_PATH=/home/assetto/server-manager/assetto/content
PORT=3000

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_SSL=false
REDIS_STREAM_KEY=ac:events
REDIS_STREAM_MAXLEN=200000

# --- Convex ---
CONVEX_DEPLOYMENT_URL=
CONVEX_PRODUCT_KEY=
CONVEX_INGEST_SECRET=
CONVEX_WORKER_SECRET=
CONVEX_PLAYER_JOIN_QUERY=workerPlayers:getPlayerJoinContext
CONVEX_HUD_SESSION_QUERY=hud:getHudSession
CONVEX_HUD_VERSION_QUERY=hud:getHudVersion

# --- ac-data API ---
API_KEY=
HUD_API_KEY=
ADMIN_JWT_SECRET=
ADMIN_USER=
ADMIN_PASS=

# --- HUD transport (WSS-first) ---
HUD_WS_ENABLED=true
HUD_WS_KEEPALIVE_MS=30000
# Legacy SSE route removed; keep false
HUD_SSE_ENABLED=false
# Overlay presence TTL (Redis key ac:hud:sse:* — name kept for telemetry matchmaking)
HUD_SSE_PRESENCE_TTL_SEC=45
# BATTLE_REQUIRE_HUD_SSE = overlay presence gate for matchmaking (not SSE transport)
BATTLE_REQUIRE_HUD_SSE=true

# --- Battle session refresh (getHudSession) ---
# Session refresh runs on battle_finished only (not battle_update). Retries until ELO changes.
# HUD_BATTLE_REFRESH_DELAY_MS=400
# HUD_BATTLE_ELO_RETRY_ATTEMPTS=3
# HUD_BATTLE_ELO_RETRY_MS=400

# --- User enforcement ---
USER_BAN_ENABLED=true
USER_REGISTRATION_REQUIRED=true

# --- Optional diagnostics ---
# HUD_CONVEX_QUERY_LOG_INTERVAL_MS=60000

# --- Dev defaults (override in prod) ---
REDIS_CONFIG_APPLIER_ENABLED=true
REDIS_EVENTS_BRIDGE_ENABLED=true
SERVER_POOL_ENABLED=false
