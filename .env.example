# Copy to .env.local (dev) or .env.production (prod):
#   cp .env.example .env.local
#   cp .env.example .env.production
#
# start.sh exports ASSETTO_ENV and ASSETTO_ENV_FILE for all services.

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SSL=false
# Normal Redis commands: socket read timeout in seconds (0 = unlimited).
REDIS_SOCKET_TIMEOUT_SEC=10
# Blocking consumers (XREADGROUP BLOCK, pub/sub): keep 0 so BLOCK waits do not time out.
REDIS_BLOCKING_SOCKET_TIMEOUT_SEC=0
REDIS_HEALTH_CHECK_INTERVAL_SEC=30
REDIS_CONFIG_XREAD_BLOCK_MS=5000

# Stream keys (same for both services)
REDIS_STREAM_KEY=ac:events
REDIS_CONFIG_STREAM_KEY=ac:config
REDIS_STREAM_MAXLEN=200000
REDIS_SCHEMA_VERSION=1

# Instance ID (same for both Python and Node; unique per VPS in a fleet)
AC_INSTANCE_ID=vps-eu-1

# Redis stream consumers — unique per VPS (shared REDIS_CONSUMER_GROUP across fleet)
REDIS_CONSUMER_GROUP=ac-data-consumers
REDIS_CONSUMER_NAME=ac-data-vps-eu-1

# Server paths (comma-separated where noted in telemetry)
SERVERS_PATH=/home/jose/assetto-infra/server
TIME_ATTACK_SERVERS_PATH=/home/jose/assetto-install/assetto/server-timeattack
EVENTS_SERVERS_PATH=

# ac-data API
PORT=3000
API_KEY=
# Local dev: http://localhost:3000 — staging/prod: https://dev-admin.yourdomain.com
CORS_ORIGIN=http://localhost:3000
# When Caddy terminates TLS: bind ac-data to localhost only
# AC_DATA_BIND_HOST=127.0.0.1
# STAGING_API_URL=https://dev-api.yourdomain.com
# STAGING_ADMIN_URL=https://dev-admin.yourdomain.com
CONTENT_PATH=/home/jose/assetto-install/assetto/content

# ProjectD HUD releases (overlay ZIP) + public launcher API (/client)
PROJECTD_HUD_PATH=/home/jose/assetto-infra/ac-data/projectd-hud
CLIENT_SYNC_MAX_ZIP_MB=500
# Public launcher (no API key by default)
CLIENT_LAUNCHER_RATE_LIMIT_MAX=60
CLIENT_LAUNCHER_DOWNLOAD_RATE_LIMIT_MAX=10
CLIENT_LAUNCHER_CORS_ORIGIN=*
CLIENT_LAUNCHER_REQUIRE_API_KEY=false
# Public IP/hostname for acstuff join links (game VPS, NOT the API domain)
# LAUNCHER_AC_HOST=13.140.160.131
# Optional: override DLC catalog (default ac-data/config/launcher-content-catalog.json)
# LAUNCHER_CONTENT_CATALOG_PATH=/path/to/launcher-content-catalog.json
# Optional: disk cache for mod download ZIPs (default ac-data/.content-zip-cache)
# CLIENT_SYNC_ZIP_CACHE_PATH=/var/cache/assetto/content-zips
# Optional: require key on /client when true (legacy / staging)
# CLIENT_SYNC_API_KEY=change-me-desktop-sync

# Python telemetry settings
REDIS_CONFIG_CONSUMER_ENABLED=true
REDIS_CONFIG_CONSUMER_GROUP=ac-config-consumers
REDIS_CONFIG_CONSUMER_NAME=py-vps-eu-1
# Python only updates in-memory modes; ac-data writes INI and restarts AC servers
LOG_LEVEL=INFO
REDIS_PUBLISH_QUEUE_SIZE=4096
REDIS_PUBLISH_WORKERS=1
# SKIP_LEGACY_SERVER_CFG=true

# Server pool (on-demand: 300 logical, few processes)
# SERVER_POOL_MODE=true          # only start AC when Convex isActive===true
# SERVER_POOL_ENABLED=true       # stop after idle minutes with zero players
# SERVER_POOL_IDLE_SHUTDOWN_MINUTES=15
# SERVER_POOL_TICK_MS=60000

# Server status throttling
SERVER_STATUS_POLL_INTERVAL_SEC=15
SERVER_STATUS_PUBLISH_INTERVAL_SEC=30
SERVER_STATUS_HEARTBEAT_INTERVAL_SEC=300
SERVER_STATUS_ON_CHANGE_ONLY=true
# CAR_INFO_SETTLE_MS=400
# GHOST_DRIVER_TIMEOUT_MS=90000
# GHOST_CARINFO_DEBOUNCE_MS=2000
# CAR_UPDATE_WATCHDOG_MS=3000
# MIN_VALID_LAP_MS=10000

# Admin panel cookies (login). Use ADMIN_COOKIE_SECURE=true only behind HTTPS.
# SameSite=None requires Secure; default Lax works for http://host:3000/admin
# ADMIN_COOKIE_SECURE=false
# ADMIN_COOKIE_SAMESITE=lax

# Convex Cloud (get from https://convex.cloud dashboard)
CONVEX_DEPLOYMENT_URL=https://your-deployment.convex.cloud
CONVEX_PRODUCT_KEY=dev:your-deployment|your-key-here
CONVEX_WORKER_SECRET=your-worker-secret
CONVEX_INGEST_SECRET=your-ingest-secret

# ac-data Redis → Convex ingest batching (align with Convex WORKER_INGEST_MAX_BATCH_SIZE)
# WORKER_INGEST_MAX_BATCH_SIZE=64
# WORKER_INGEST_FLUSH_INTERVAL_MS=5000
# REDIS_INGEST_READ_COUNT=64

# HUD cache (Convex → Redis → SSE /hud/stream)
HUD_LAP_REFRESH_DEBOUNCE_MS=1500
HUD_LAP_REFRESH_DELAY_MS=800
# Dev tuning for faster PB lap HUD tests: HUD_LAP_REFRESH_DEBOUNCE_MS=400 HUD_LAP_REFRESH_DELAY_MS=300
# Push hud_session to rival SSE clients on same lobby when someone completes a PB lap (rank/rivals may change)
HUD_LAP_RIVAL_FANOUT_ENABLED=true
HUD_BATTLE_REFRESH_DELAY_MS=400
HUD_SESSION_RIVALS_RETRY_ATTEMPTS=3
HUD_SESSION_RIVALS_RETRY_MS=300
HUD_SESSION_FETCH_RETRY_ATTEMPTS=3
HUD_SESSION_FETCH_RETRY_MS=400
# Legacy aliases (still read by ac-data if HUD_SESSION_FETCH_* unset)
# HUD_PLAYER_FETCH_RETRY_ATTEMPTS=3
# HUD_PLAYER_FETCH_RETRY_MS=400
HUD_BATTLE_ELO_RETRY_ATTEMPTS=3
HUD_BATTLE_ELO_RETRY_MS=400
REDIS_PENDING_RECLAIM_MIN_IDLE_MS=60000
REDIS_PENDING_RECLAIM_BATCH=50
HUD_VER_TTL_SEC=3600
HUD_PLAYER_TTL_SEC=10
HUD_SESSION_TTL_SEC=300
HUD_TRANSIENT_ERROR_TTL_SEC=10
HUD_PRESENCE_TTL_SEC=180
HUD_PRESENCE_JOIN_TTL_SEC=600
# Global ban when Convex profile isInvalidated (ac-data writes Redis; telemetry kicks)
USER_BAN_ENABLED=true
USER_INVALIDATED_REDIS_PREFIX=ac:user:invalidated:
USER_INVALIDATED_CHANNEL=ac:user:invalidated
USER_INVALIDATED_TTL_SEC=86400
# On connect: wait for ac-data player_join → Convex before kicking (ms × attempts)
USER_BAN_DEFER_POLL_MS=250
USER_BAN_DEFER_ATTEMPTS=8
# Unified player join query (ban + HUD cache seed on player_join)
CONVEX_PLAYER_JOIN_QUERY=workerPlayers:getPlayerJoinContext
HUD_RATE_LIMIT_MAX=30
# Optional: clients with X-API-Key matching HUD_API_KEY get a higher per-steamId/IP limit
HUD_RATE_LIMIT_AUTH_MAX=120
HUD_API_KEY=
HUD_CORS_ORIGIN=*
# Convex queries for HUD (pushed via SSE hud_session / hud_version; session-only)
CONVEX_HUD_SESSION_QUERY=hud:getHudSession
CONVEX_HUD_VERSION_QUERY=hud:getHudVersion
# Worker config poll (replaces HUD cache sync + top-10 snapshots)
CONVEX_WORKER_SYNC_QUERY=workerSync:getWorkerInstanceSyncVersion
# Alias used by some Convex deployments (falls back to CONVEX_WORKER_SECRET)
# WORKER_INGEST_SECRET=your-worker-secret

# Battle HUD (Python → Redis → SSE /hud/stream; disables in-game battle chat when true)
BATTLE_HUD_ENABLED=true
HUD_BATTLE_TTL_SEC=120
HUD_BATTLE_DEBOUNCE_MS=300
HUD_BATTLE_CLEAR_DELAY_SEC=5
# Battle HUD SSE push (EventSource) — recommended for CSP overlays
HUD_SSE_ENABLED=true
HUD_SSE_KEEPALIVE_MS=30000
# Overlay SSE heartbeat for battle matchmaking (ac-data writes ac:hud:sse:*)
HUD_SSE_PRESENCE_TTL_SEC=45
# Require overlay connected to /hud/stream before pairing (telemetry-data)
BATTLE_REQUIRE_HUD_SSE=false

# --- Fleet / multi-VPS (see docs/VPS_FLEET_SETUP.md) ---
# Each VPS MUST have a distinct AC_INSTANCE_ID registered in Convex worker sync.
# REDIS_CONSUMER_NAME and REDIS_CONFIG_CONSUMER_NAME must also be unique per host.
# REDIS_HOST / REDIS_PASSWORD may be shared (Redis Cloud fleet).
# Battle HUD Redis keys are scoped as {AC_INSTANCE_ID}_{lobby_name} — no cross-VPS
# collision when instance IDs differ, even if server_cfg.ini NAME= matches another VPS.
# Optional: CORS_ORIGINS=http://overlay.example.com,http://admin.example.com

# Battle / touge tuning
BATTLE_ARM_MAX_GAP_METERS=15
BATTLE_ARM_MIN_SPEED_KMH=40
BATTLE_ARM_SUSTAINED_PROXIMITY_SEC=5
BATTLE_FINISHED_COOLDOWN_SEC=20
BATTLE_MIN_LAP_PROGRESS_BEFORE_FINISH=0.30
BATTLE_FINISH_POINT_MIN_GAP_METERS=20
BATTLE_DISAPPEAR_GAP_METERS=250
BATTLE_ABANDON_STALL_SEC=5
BATTLE_ABANDON_MIN_PROGRESS_METERS=200
BATTLE_OVERTAKE_MAX_GAP_FALLBACK_METERS=20
BATTLE_SPLINE_STUCK_SEC=2
BATTLE_SPLINE_STUCK_MIN_SPEED_KMH=25
BATTLE_SPLINE_MIN_MOVE_METERS=5
BATTLE_POSITION_AHEAD_MIN_METERS=2
OVERTAKE_MAX_GAP_METERS=15
OVERTAKE_POINT_COOLDOWN_SEC=2.0
