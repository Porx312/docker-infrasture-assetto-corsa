{
  "name": "@projectd/ac-data-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "description": "ProjectD ac-data hub: Convex ingest, HUD gateway, admin",
  "scripts": {
    "predev": "npm run build --prefix ../ac-data-shared",
    "dev": "tsx watch src/index.ts",
    "build": "rimraf ./dist && tsc -p tsconfig.build.json && node scripts/write-build-info.mjs",
    "start": "node dist/index.js",
    "test": "bash -c 'export NODE_ENV=test SKIP_ASSETTO_ENV_LOAD=1; export SERVERS_PATH=\"${SERVERS_PATH:-$(mktemp -d /tmp/assetto-ci-servers-XXXXXX)}\"; mkdir -p \"$SERVERS_PATH\"; shopt -s globstar; exec tsx --test test/**/*.test.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@projectd/ac-data-shared": "1.0.0",
    "convex": "^1.29.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.23.0",
    "redis": "^5.10.0",
    "rimraf": "^6.0.1",
    "unzipper": "^0.12.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.23.1",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
