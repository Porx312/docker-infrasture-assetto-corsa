# Backend hub — copy to HUB ROOT (not this folder):
#   copy packages\ac-data-backend\.env.example ..\..\.env.local
# Required before start (or set ALLOW_INSECURE_DEFAULTS=true for local smoke tests only).

PORT=3000
AC_DATA_BIND_HOST=0.0.0.0
# ALLOW_INSECURE_DEFAULTS=true

CONVEX_DEPLOYMENT_URL=
CONVEX_PRODUCT_KEY=
CONVEX_INGEST_SECRET=
CONVEX_WORKER_SECRET=

HUD_API_KEY=

ADMIN_JWT_SECRET=
ADMIN_USER=
ADMIN_PASS=

HUD_GATEWAY_ENABLED=true
# Optional manual lobby→edge map; dynamic registry from edge POST /hud/registry/sync is preferred.
HUD_EDGE_REGISTRY={"ProjectD":"http://127.0.0.1:3001"}
HUD_CORS_ORIGIN=*
# Public hub URL for bootstrap ws.fallback (defaults to request Host / X-Forwarded-*)
# HUD_PUBLIC_BASE_URL=https://api.projectd.space

# Fleet admin + HUD gateway HTTP proxy to private edge IPs (same CONVEX_WORKER_SECRET)
# FLEET_EDGE_REGISTRY={"eu":{"label":"EU VPS","baseUrl":"http://10.0.0.2:3000","instanceId":"vps-eu-2"}}
# Hub-only Convex: edges use BACKEND_INGEST_URL + BACKEND_WORKER_URL; webhooks hit this hub /hud/worker/*
# REDIS_CONFIG_SYNC_ON_HUB=true

# Mod repository (PostgreSQL + distribution agent)
# DATABASE_URL=postgres://acdata:secret@127.0.0.1:5432/acdata
# MOD_UPLOAD_ROOT=/var/lib/ac-data/mod-uploads
# MOD_STORAGE_MODE=local
# MOD_MASTER_LOCAL_PATH=/var/lib/ac-data/mod-uploads/master
# MOD_HUB_PUBLIC_URL=https://hub.example.com
# MOD_S3_BUCKET=
# MOD_S3_ACCESS_KEY_ID=
# MOD_S3_SECRET_ACCESS_KEY=
# MOD_S3_ENDPOINT=
# MOD_S3_REGION=auto

# Fleet hub: central mod library (legacy upload UI; prefer Mod distribution tab)
HUB_OWNS_CONTENT=true
CONTENT_PATH=/home/assetto/server-manager/assetto/content
# CONTENT_FLEET_SYNC_ENABLED=true   # deprecated — use mod distribution
# CONTENT_SYNC_SSH_USER=assetto
# CONTENT_SYNC_REMOTE_PATH=/home/assetto/server-manager/assetto/content
# PROJECTD_HUD_PATH=packages/ac-data-backend/projectd-hud
# CLIENT_LAUNCHER_CORS_ORIGIN=*

# Admin content paths (single-node dev only; fleet hub may omit SERVERS_PATH)
SERVERS_PATH=/home/jose/assetto-infra/server

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Control API (/v1 live + mods inventory + desired-config) — this process is CONTROL_API_URL
# MODS_INVENTORY_TTL_SEC=86400

# Loading screens / banners: stored under data/branding, public GET /branding/images/:file
# BRANDING_IMAGES_PATH=/home/jose/assetto-infra/ProjectD-Backend-Servers/data/branding
# (default: sibling of CONTENT_PATH named branding)
# Requires HUD_PUBLIC_BASE_URL so Upload returns absolute URLs for CM
