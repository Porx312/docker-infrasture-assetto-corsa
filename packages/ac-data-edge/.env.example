# Edge VPS — copy to repo root .env.local / .env.production (ASSETTO_ENV_FILE)

AC_INSTANCE_ID=default
SERVERS_PATH=/home/jose/assetto-infra/server
# Required for mod inventory/agent: real AC content tree (cars/ + tracks/)
CONTENT_PATH=/home/assetto/server-manager/assetto/content
# Mod agent (folder-first; shared pool via CONTENT_PATH + server/*/content symlinks)
MOD_AGENT_ENABLED=true
EDGE_ID=eu
# Install-on-start: wait for S3 pulls before AC start (ms)
# MOD_START_INSTALL_TIMEOUT_MS=300000
# MOD_START_INSTALL_POLL_MS=2500
# MOD_START_RESYNC_EVERY_MS=15000
# Deprecated: legacy ZIP blobs only — unset after POST …/gc-blobs
# AC_MOD_ROOT=/var/lib/ac-mods
PORT=3000

# Shared Redis with hub/backend (required for multi-VPS). Localhost only for offline lab.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_STREAM_KEY=ac:events
REDIS_CONFIG_STREAM_KEY=ac:config

# --- Hub-centric production (recommended multi-VPS) ---
# Event ingest → hub → Convex
BACKEND_INGEST_URL=https://your-hub.example.com
# Private base URL the hub uses to reach this edge (HTTP proxy / admin). Required for multi-VPS unless hub-only dev.
# EDGE_REGISTRY_BASE_URL=http://10.0.0.2:3000
# Public HTTPS base for player HUD WSS (bootstrap ws.primary)
# EDGE_PUBLIC_BASE_URL=https://eu-api.your-domain.com
# Worker queries (join, HUD session) → hub → Convex (defaults to BACKEND_INGEST_URL if unset)
# BACKEND_WORKER_URL=https://your-hub.example.com
# On edge: omit CONVEX_DEPLOYMENT_URL, CONVEX_PRODUCT_KEY, CONVEX_INGEST_SECRET
# Hub↔edge HTTP auth (ingest, worker RPC, mod-agent, presence): FLEET_EDGE_SECRET
# Must match hub FLEET_EDGE_SECRET and differ from CONVEX_WORKER_SECRET in prod/strict.
FLEET_EDGE_SECRET=
# Optional: Convex SDK on edge only for single-VPS / CONVEX_DIRECT_ON_EDGE
# CONVEX_WORKER_SECRET=
REDIS_CONFIG_SYNC_ON_EDGE=false
# Must be true on fleet edges so first Redis snapshot after boot can start acServer.
REDIS_CONFIG_APPLIER_RESTART_ON_BOOT=true
# After S3 mod install finishes late: retry apply/start (ms backoff list via PENDING_BACKOFF_MS).
# REDIS_CONFIG_APPLIER_PENDING_MAX_ATTEMPTS=8

# --- Single-VPS dev (edge talks to Convex directly) ---
# CONVEX_DIRECT_ON_EDGE=true
# CONVEX_DEPLOYMENT_URL=
# CONVEX_PRODUCT_KEY=
# CONVEX_INGEST_SECRET=
# CONVEX_WORKER_SECRET=
# With ALLOW_INSECURE_DEFAULTS=true (dev only), FLEET_EDGE_SECRET may fall back to CONVEX_WORKER_SECRET


API_KEY=
HUD_API_KEY=
# Prefer header x-api-key. Query ?api_key= is rejected when ASSETTO_ENV=prod|production.
# ALLOW_API_KEY_QUERY=false
HUD_WS_ENABLED=true
# CORS: set explicit origin in prod (default * is warned at boot)
# HUD_CORS_ORIGIN=https://host.example.com

REDIS_EVENTS_BRIDGE_ENABLED=true
REDIS_CONFIG_APPLIER_ENABLED=true

# Disk inventory scan → hub POST /v1/agents/{AC_INSTANCE_ID}/mods (Host picker)
# MOD_INVENTORY_SCAN_ENABLED=true
# MOD_INVENTORY_SCAN_MS=900000

# Join/leave/status → Convex live_players (default false after fleet cutover).
# Requires ProjectD Convex `presence` support — see docs/HUD_HARDENING_CUTOVER.md
# LIVE_INGEST_CONVEX=false

# Admin UI lives on the hub only. Edge /admin is JSON for hub proxy (X-Worker-Secret).
# Do not expose edge /admin to the Internet.
# Strict/prod: distinct secrets (fallback only with ALLOW_INSECURE_DEFAULTS):
# FLEET_EDGE_SECRET=
# MOD_PEER_SECRET=
# Cap concurrent peer-pull installs (hub orchestrator): MOD_PEER_PULL_MAX_CONCURRENT=3
# REDIS_STREAM_PENDING_WARN=500
